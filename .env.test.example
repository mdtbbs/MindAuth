# Native test environment only. Copy to .env.test; never commit real credentials.
NODE_ENV=test

# This example uses a Unix socket with a local passwordless development account.
# For TCP, omit MYSQL_SOCKET_PATH and set MYSQL_HOST, MYSQL_USER, and MYSQL_PASSWORD.
MYSQL_SOCKET_PATH=/run/mysqld/mysqld.sock
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=test_mindauth

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=15

BASE_URL=http://localhost:4001
ADMIN_SECRET=test-only-admin-secret-at-least-32-characters
SECRETS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ALLOWED_ORIGINS=http://localhost:4001
