# MindAuth 环境配置示例
# 复制此文件为 .env 并填入实际值

# ===== 服务配置 =====
PORT=4001

# 运行环境（生产环境必须设置为 production）
NODE_ENV=development

# 系统基础URL（用于邮件链接）
# 生产环境设置为实际域名，如: https://auth.example.com
BASE_URL=http://localhost:4001

# 管理员创建密钥（生产环境必须修改！）
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=请使用强随机密钥替换此值

# ===== MySQL 配置 =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=mindauth
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=mindauth
MYSQL_POOL_SIZE=10

# ===== Redis 配置 =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 仅用于本地/CI 测试：将会话、OAuth token、限流全部降级为进程内存 Redis。
# 生产环境禁止开启（config/validate.js 会在 NODE_ENV=production 时阻断启动）。
# USE_MEMORY_REDIS=1

# ===== 邮件配置 (可选，也可在管理后台配置) =====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_password
SMTP_FROM=noreply@example.com
SMTP_SECURE=false

# ===== CDN 配置 =====
# CDN 基础 URL (用于静态资源)
# 示例: https://cdn.example.com
CDN_URL=

# 允许跨域访问的来源 (逗号分隔)
# 示例: https://forum.example.com,https://manager.example.com
# 使用 * 允许所有来源 (不推荐生产环境)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:4001

# ===== 反向代理/CDN 信任配置 =====
# 如果 MindAuth 部署在反向代理（Nginx、Cloudflare 等）后面，
# 需要配置信任的代理 IP，以便正确提取客户端真实 IP。
# 不配置时，直接使用 req.ip（适用于直接暴露或已配置 trust proxy 的场景）。

# 启用信任代理（设为 true 时下面的 IPS 才会生效）
# TRUSTED_PROXY_ENABLED=false

# 信任的代理 IP 列表（逗号分隔）
# 示例: 10.0.0.1,172.16.0.0/12
# TRUSTED_PROXY_IPS=

# 信任 Cloudflare IP 段（自动提取 CF-Connecting-IP）
# TRUST_CLOUDFLARE=false

# ===== 阿里云短信服务 (dysmsapi) =====
# 需要在阿里云短信服务控制台开通并创建签名和模板
# 模板变量: ${code} (6位数字验证码)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ===== 生产环境安全建议 =====
# 1. ADMIN_SECRET 使用至少32字符的随机字符串
# 2. NODE_ENV=production 启用安全cookie
# 3. 必须启用HTTPS
# 4. MySQL和Redis使用独立用户和强密码
# 5. 定期备份MySQL数据库
# 6. CDN_URL 配置后 CSP 会自动允许 CDN 资源
# 7. ALLOWED_ORIGINS 只添加信任的域名
# 8. 生产环境 BASE_URL 不能是 localhost
