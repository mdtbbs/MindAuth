# MindAuth 环境配置示例
# 复制此文件为 .env 并填入实际值

# ===== 服务配置 =====
PORT=4001

# 运行环境（生产环境必须设置为 production）
NODE_ENV=development

# 系统基础URL（用于邮件链接）
# 生产环境设置为实际域名，如: https://auth.example.com
BASE_URL=http://localhost:4001

# 管理员创建密钥（生产环境必须修改！）
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=请使用强随机密钥替换此值

# ===== MySQL 配置 =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=mindauth
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=mindauth
MYSQL_POOL_SIZE=10

# ===== Redis 配置 =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== 邮件配置 (可选，也可在管理后台配置) =====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_password
SMTP_FROM=noreply@example.com
SMTP_SECURE=false

# ===== 生产环境安全建议 =====
# 1. ADMIN_SECRET 使用至少32字符的随机字符串
# 2. NODE_ENV=production 启用安全cookie
# 3. 必须启用HTTPS
# 4. MySQL和Redis使用独立用户和强密码
# 5. 定期备份MySQL数据库