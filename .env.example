# 服务端口
PORT=4001

# 管理员创建密钥（生产环境必须修改！）
# 生成方法: openssl rand -base64 32 或 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=请使用强随机密钥替换此值

# 系统基础URL（用于邮件链接）
# 生产环境设置为实际域名，如: https://auth.example.com
BASE_URL=http://localhost:4001

# 运行环境（生产环境必须设置为 production）
NODE_ENV=development

# ===== 邮件配置 =====
# SMTP服务器地址
SMTP_HOST=smtp.example.com
# SMTP端口（465为SSL，587为TLS）
SMTP_PORT=587
# SMTP用户名
SMTP_USER=your@email.com
# SMTP密码或授权码
SMTP_PASS=your_password
# 发件人地址
SMTP_FROM=noreply@example.com
# 是否启用SSL（465端口设为true）
SMTP_SECURE=false

# ===== 安全建议 =====
# 1. ADMIN_SECRET 使用至少32字符的随机字符串
# 2. 生产环境必须启用HTTPS
# 3. SMTP_PASS 不要使用明文密码，建议使用授权码
# 4. 定期备份数据库文件 users.db