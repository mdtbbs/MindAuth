# MindAuth 环境配置示例
# 复制此文件为 .env 并填入实际值

# ===== 服务配置 =====
PORT=4001

# Encrypts SMTP and SMS provider secrets stored in MySQL (32-byte hex key).
SECRETS_ENCRYPTION_KEY=please-replace-with-64-hex-characters

# 运行环境（生产环境必须设置为 production）
NODE_ENV=development

# 系统基础URL（用于邮件链接）
# 生产环境设置为实际域名，如: https://auth.example.com
BASE_URL=http://localhost:4001

# 管理员创建密钥（生产环境必须修改！）
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=请使用强随机密钥替换此值
# 生产环境 ADMIN_SECRET 最小长度，默认 32
# ADMIN_SECRET_MIN_LENGTH=32

# 服务间用户名密码验证 API 使用的 API Key
# SERVICE_API_KEY=

# 仅开发/测试环境启用测试数据种子
# ENABLE_TEST_SEEDS=false

# ===== MySQL 配置 =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=mindauth
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=mindauth
MYSQL_POOL_SIZE=10

# ===== Redis 配置 =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 仅用于本地/CI 测试：将会话、OAuth token、限流全部降级为进程内存 Redis。
# 生产环境禁止开启（config/validate.js 会在 NODE_ENV=production 时阻断启动）。
# USE_MEMORY_REDIS=1

# ===== 邮件配置 (可选，也可在管理后台配置) =====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_password
SMTP_FROM=noreply@example.com
SMTP_SECURE=false

# ===== CDN 配置 =====
# CDN 基础 URL (用于静态资源)
# 示例: https://cdn.example.com
CDN_URL=

# 允许跨域访问的来源 (逗号分隔)
# 示例: https://forum.example.com,https://manager.example.com,https://lanlink.example.com
# 使用 * 允许所有来源 (不推荐生产环境)
# 注意：需包含 LanLink 控制面的公网地址（如 wss://lanlink.example.com 对应 https://lanlink.example.com）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:4001,http://localhost:5100

# ===== 反向代理/CDN 信任配置 =====
# 如果 MindAuth 部署在反向代理（Nginx、Cloudflare 等）后面，
# 需要配置信任的代理 IP，以便正确提取客户端真实 IP。
# 不配置时，直接使用 req.ip（适用于直接暴露或已配置 trust proxy 的场景）。

# 启用信任代理（设为 true 时下面的 IPS 才会生效）
# TRUSTED_PROXY_ENABLED=false

# 信任的代理 IP 列表（逗号分隔）
# 示例: 10.0.0.1,172.16.0.0/12
# TRUSTED_PROXY_IPS=

# 信任 Cloudflare IP 段（自动提取 CF-Connecting-IP）
# TRUST_CLOUDFLARE=false

# 阿里云 ESA 自动加载可信代理 IP 段
# ALIYUN_ESA_AUTO_TRUST=false
# ALIYUN_ESA_SITE_ID=
# ALIYUN_ESA_REGION_ID=cn-hangzhou
# ALIYUN_ESA_REFRESH_INTERVAL_MS=600000

# ===== 阿里云短信服务 (dysmsapi) =====
# 需要在阿里云短信服务控制台开通并创建签名和模板
# 模板变量: ${code} (6位数字验证码)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ===== LanLink 设备授权流 (RFC 8628) =====
# 用于 LanLink Mod 登录 MindAuth，用户在 Mod 中获取 user_code，
# 然后在论坛网页确认授权。

# 设备码有效期（秒），默认 900 (15 分钟)
# MINDAUTH_DEVICE_CODE_TTL_SECONDS=900

# Mod 轮询间隔（秒），默认 5
# MINDAUTH_DEVICE_POLL_INTERVAL_SECONDS=5

# 授权页面基础 URL，用于生成 verification_uri
# 默认使用 BASE_URL。如果授权页面部署在不同域名，需显式设置
# 示例: https://auth.example.com
# MINDAUTH_VERIFICATION_URI=

# 用户码格式: LL-XXXX-XXXX (8 字符，去除 0/O/1/I 防混淆)
# user_code 唯一性检查失败时自动重试，最多 10 次

# ===== QQ OAuth 配置（可选）=====
# 默认关闭。只有显式设为 true 才会启用 QQ 登录。
# 需在 QQ 开放平台创建应用并获取以下凭据。
# QQ_OAUTH_ENABLED=true 时以下三项必须配置完整。
QQ_OAUTH_ENABLED=false
QQ_CLIENT_ID=
QQ_CLIENT_SECRET=

# 本地开发：
# QQ_REDIRECT_URI=http://localhost:4001/api/auth/qq/callback
# 生产环境：
QQ_REDIRECT_URI=https://auth.example.com/api/auth/qq/callback
# 必须与 QQ 开放平台登记的回调地址完全一致。
# 生产环境必须使用 HTTPS。
# QQ API 请求超时（毫秒），范围 1000-30000，默认 5000。
QQ_HTTP_TIMEOUT_MS=5000

# ===== 生产环境安全建议 =====
# 1. ADMIN_SECRET 使用至少32字符的随机字符串
# 2. NODE_ENV=production 启用安全cookie
# 3. 必须启用HTTPS
# 4. MySQL和Redis使用独立用户和强密码
# 5. 定期备份MySQL数据库
# 6. CDN_URL 配置后 CSP 会自动允许 CDN 资源
# 7. ALLOWED_ORIGINS 只添加信任的域名
# 8. 生产环境 BASE_URL 不能是 localhost
