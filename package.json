{
  "name": "mindauth",
  "version": "1.0.0",
  "description": "MindAuth - OAuth 2.0 authentication service with MySQL and Redis",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "npm run build:client",
    "build:client": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint not configured yet'",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "npx playwright test",
    "verify": "npm run typecheck && npm run build && npm run test:unit"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "mysql2": "^3.22.3",
    "nodemailer": "^9.0.3",
    "redis": "^5.12.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
